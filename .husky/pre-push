#!/usr/bin/env sh
# pre-push: 与 CI 等价的本地检查门禁
# 任意步骤失败即阻止 push，避免远端 CI 红灯
# (跳过: git push --no-verify)
echo "pre-push: 运行与 CI 等价的本地检查 (build/typecheck/lint/format/test/count/selfcheck)" >&2
echo "" >&2

# mise 用户兜底: 非交互 shell 的 PATH 常无 shims, 裸调 npm 会 "not found" 误拦截推送 (#39)
if ! command -v npm >/dev/null 2>&1; then
    for _shim in "$HOME/.local/share/mise/shims" "$HOME/.mise/shims"; do
        if [ -x "$_shim/npm" ]; then
            PATH="$_shim:$PATH"
            break
        fi
    done
    unset _shim
fi

npm run precheck || {
  echo "" >&2
  echo "pre-push 检查失败，已阻止本次 push" >&2
  echo "修复后重试，或紧急情况使用: git push --no-verify" >&2
  exit 1
}

echo "" >&2
echo "pre-push 检查通过，继续 push" >&2
