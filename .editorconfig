# EditorConfig — 跨编辑器统一格式
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,mjs,cjs}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.husky/*]
end_of_line = lf
