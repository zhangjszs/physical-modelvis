{
  "name": "physics-core",
  "version": "1.0.0",
  "description": "面向高中物理教学的二维/三维物理模拟引擎核心 (零依赖, 解析解 + Boris 数值积分)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "author": "zhangjszs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangjszs/physical-modelvis.git",
    "directory": "physics-core"
  },
  "keywords": [
    "physics",
    "physics-engine",
    "simulation",
    "education",
    "numerical-integration",
    "boris",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=../.scratch/core-tests.json",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
