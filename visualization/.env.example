# ==============================================================================
# PhysVis - OCR 后端代理环境变量配置模板
# ==============================================================================
# 使用方法：
# 复制本文件为 .env 或在启动服务前导出环境变量：
#   cp .env.example .env
# ==============================================================================

# Anthropic API 认证 Token 或 API Key (必填)
ANTHROPIC_AUTH_TOKEN="your-anthropic-api-key-here"

# Anthropic API 基础服务地址 (可选，支持反向代理 / 中转服务，默认: https://api.anthropic.com)
ANTHROPIC_BASE_URL="https://api.anthropic.com"

# 识别使用的视觉模型名称 (可选，默认: claude-sonnet-4-6)
ANTHROPIC_MODEL="claude-sonnet-4-6"

# OCR 代理本地监听端口 (可选，默认: 3001)
OCR_PROXY_PORT="3001"
