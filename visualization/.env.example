# ==============================================================================
# PhysVis - OCR 后端代理环境变量配置模板
# ==============================================================================
# 使用方法：
# 复制本文件为 .env 或在启动服务前导出环境变量：
#   cp .env.example .env
# ==============================================================================

# 默认提供方 (#74, 可选)：anthropic | openai | 任意动态 OpenAI 兼容槽位前缀的小写 (如 deepseek)
# 缺省 anthropic；anthropic 未配置时自动回落首个可用提供方 (启动日志明示)
OCR_PROVIDER="anthropic"

# Anthropic API 认证 Token 或 API Key (ANTHROPIC_API_KEY 二选一；仅用其他提供方时可不配)
ANTHROPIC_AUTH_TOKEN="your-anthropic-api-key-here"

# Anthropic API 基础服务地址 (可选，支持反向代理 / 中转服务，默认: https://api.anthropic.com)
ANTHROPIC_BASE_URL="https://api.anthropic.com"

# 识别使用的视觉模型名称 (可选，默认: claude-sonnet-4-6)
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- OpenAI 兼容提供方 (#74) -------------------------------------------------
# 内置 openai 槽位 (TOKEN/KEY 二选一；BASE_URL 缺省 https://api.openai.com/v1)：
# OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o"
#
# 动态槽位：任意 <PREFIX>_API_KEY|_AUTH_TOKEN + <PREFIX>_BASE_URL 齐备即注册为
# OpenAI 兼容提供方 (id = 前缀小写)，一套适配器覆盖 DeepSeek / Qwen(DashScope 兼容) /
# 智谱 GLM / Moonshot / SiliconFlow / OpenRouter / Gemini 兼容端点。示例 (DeepSeek)：
# DEEPSEEK_API_KEY="sk-..."
# DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
# DEEPSEEK_MODEL="deepseek-chat"

# OCR 代理本地监听端口 (可选，默认: 3001)
OCR_PROXY_PORT="3001"

# 上游 API 请求超时时间 (毫秒，可选，默认: 60000)
OCR_PROXY_TIMEOUT_MS="60000"

# 允许的模型白名单 (逗号分隔，可选，默认仅 ANTHROPIC_MODEL 本身)
# 不在白名单内的模型请求将回落到 ANTHROPIC_MODEL
# 旧全局口径，仅对 anthropic 提供方生效；各提供方请用 <PREFIX>_ALLOWED_MODELS
OCR_PROXY_ALLOWED_MODELS=""

# 各提供方独立模型白名单 (逗号分隔，可选)，如：
# ANTHROPIC_ALLOWED_MODELS="claude-sonnet-4-6,claude-haiku-4-5"
# DEEPSEEK_ALLOWED_MODELS="deepseek-chat"

# CORS 追加来源 (逗号分隔，可选；追加到默认 http://localhost:3000 / http://localhost:5173)
# OCR_PROXY_CORS_ORIGINS="https://zhangjszs.github.io"

# 前端 OCR 代理地址 (#74，构建时注入，缺省 http://localhost:3001；
# 仅前端构建用，GitHub Pages 部署时由 CI 传 VITE_OCR_PROXY_URL)
# VITE_OCR_PROXY_URL="http://localhost:3001"
