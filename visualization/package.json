{
  "name": "physvis-visualization",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "pretest": "node ../scripts/guard-dist-freshness.mjs --quiet",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=../.scratch/viz-tests.json",
    "test:watch": "vitest",
    "server:dev": "tsx server/ocr-proxy.ts",
    "lint": "eslint src/**/*.{ts,tsx} server/**/*.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "physics-core": "file:../physics-core",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "three": "^0.185.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^26.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
